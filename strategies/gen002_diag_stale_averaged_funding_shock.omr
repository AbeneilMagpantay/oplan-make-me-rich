# DEV-ONLY DIAGNOSTIC - NOT A CANDIDATE - NEVER TO BE SUBMITTED (generations/gen002/PLAN.md, version 4, S7).
# w is H11's weight row exactly as in strategies/gen002_averaged_funding_shock.omr at its defaults (an
# hourly-grid series, so lag counts hours). The signal holds w as it was k = 720 hours (30 days, the shortest
# G6 lag before its random phase) earlier, on the names in play now whose weight was known on every hour since,
# re-centred to net zero and not rescaled: one stale copy of H11, as G6 builds them. Its DEV Sharpe is compared
# with H11's.
name = "gen002_diag_stale_averaged_funding_shock"
family = "other"
kind = "portfolio"
unit = "top30"
hypothesis = "DEV-only control, never to be submitted: H11's own weights from 30 days earlier, held now (a stale copy as G6 builds them), to check on DEV that H11's claim is a timing claim, i.e. that the stale copy earns much less than H11 itself."

a = param(240, 192, 288)
b = param(672, 537, 807)
m = param(384, 307, 461)
size = param(0.1, 0.08, 0.12)
k = param(720, 576, 864)

shock = sma(funding8h, a) - sma(funding8h, b)
s = sma(cs_rank(shock), m)
w = size * cs_demean(-s)
signal = cs_demean(lag(w, k))
