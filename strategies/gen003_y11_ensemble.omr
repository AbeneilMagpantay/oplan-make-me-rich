# Generation 3, round 5, Y-11 (generations/gen003/PLAN.md, version 5, the final wide screen). An equal-weight
# combination of three of this round's ideas from three classes, each part exactly as in its own file at the same
# defaults: + rank of Y-01's kurtosis (long), - rank of Y-02's volatility of volatility (short), + rank of Y-09's
# volume commonality (long). The summed ranks are centred, then made beta neutral exactly as in the parts (the centred
# sum's residual on the coins' centred daily beta to BTC over nb days); gross 1; traded at the Monday 00:00 open. A coin
# is held only where all three parts are known. No funding, mark or index input.
name = "gen003_y11_ensemble"
family = "other"
kind = "portfolio"
unit = "top30"
hypothesis = "Combination: jump risk (paid), uncertainty about risk (overpriced) and liquidity commonality (paid) are three near-unrelated weekly measures; k signals of Sharpe S give about S x sqrt(k) while their trades partly net. Long high kurtosis, low volatility of volatility and high volume commonality in one summed rank, beta neutral, weekly. Falsified if the DEV screen fails (sign never flipped), VAL PSR(0) < 0.90, 2x costs negative, no G6 timing, or next30 disagrees."

m = param(2, 1, 3)             # Y-01: weekly bins pooled in the moments (2 weeks)
kv = param(21, 16, 26)         # Y-02: days in the variability of the daily volatility (3 weeks)
kc = param(28, 22, 34)         # Y-09: days in the volume correlation (4 weeks)
nb = param(42, 33, 51)         # days in the daily beta to BTC that neutralises the book (6 weeks)

e = logret(close, 1) - logret(btc(close), 1)
e2 = e * e
v2 = sma(tf_mean(e2, weekly), m)
kurt = sma(tf_mean(e2 * e2, weekly), m) / (v2 * v2)
dv = sqrt(tf_mean(e2, daily))
vov = std(dv, kv) / sma(dv, kv)
dq = logret(daily(quote_volume), 1)
cq = corr(dq, cs_mean(dq), kc)
rd = logret(daily(close), 1)
rbd = logret(daily(btc(close)), 1)
bd = cs_demean(tf_last(corr(rd, rbd, nb) * std(rd, nb) / std(rbd, nb), weekly))
z = cs_demean(cs_rank(kurt) - cs_rank(tf_last(vov, weekly)) + cs_rank(tf_last(cq, weekly)))
w = z - cs_mean(z * bd) / cs_mean(bd * bd) * bd
signal = cs_scale(w)
