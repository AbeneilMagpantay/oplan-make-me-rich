# DEV-ONLY DIAGNOSTIC - NOT A CANDIDATE - NEVER TO BE SUBMITTED (generations/gen002/PLAN.md, version 4, D-ACF).
# w is H12's weight row exactly as in strategies/gen002_averaged_unrewarded_shift.omr at its defaults (a 4-HOUR
# series, so lag counts 4-hour rows). The signal c * w(t) * w(t - k), k = 156 rows (26 days; one G6 lag step is
# about 25.9 days), makes the sandbox's avg net / avg gross equal to sum w(t) w(t-k) / sum |w(t)| |w(t-k)|, an
# upper bound of the correlation that G6's speed limit reads (no per-name mean is removed).
name = "gen002_diag_acf_averaged_unrewarded_shift"
family = "other"
kind = "portfolio"
unit = "top30"
hypothesis = "DEV-only control, never to be submitted: measures on DEV how strongly H12's weights are correlated with its own weights about one G6 lag step (26 days) earlier, to check G6's speed limit (0.5) before any counted run. Its returns mean nothing."

a = param(60, 48, 72)
b = param(168, 134, 202)
m = param(96, 76, 116)
k = param(156, 124, 188)
c = param(20, 10, 30)

bd = (h4(close) - h4(index_close)) / h4(index_close)
p = median(bd, a) - median(bd, b)
r = logret(h4(close), a)
x = cs_demean(r)
y = cs_demean(p)
beta = cs_mean(x * y) / cs_mean(x * x)
e = y - beta * x
s = sma(cs_rank(e), m)
w = cs_scale(cs_demean(-s))
signal = c * w * lag(w, k)
