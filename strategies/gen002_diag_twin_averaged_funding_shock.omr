# DEV-ONLY DIAGNOSTIC - NOT A CANDIDATE - NEVER TO BE SUBMITTED (generations/gen002/PLAN.md, version 4, S10).
# u is the cross-sectional rank of H11's shock exactly as in strategies/gen002_averaged_funding_shock.omr at
# its defaults. At each row u is regressed across coins on the coin's q-row log return of 4-hour closes (q = 156
# rows = 26 days: the span of H11's 10-day measurement plus its 16-day rank average), and the residual, which has
# no linear exposure to that return across coins, is averaged over the same m hours and held with H11's sign and
# size. Twin = H11 minus its averaged return-aligned part; its DEV Sharpe shows whether H11's DEV result needs
# the part of the funding shock that moves with the coin's own price.
name = "gen002_diag_twin_averaged_funding_shock"
family = "other"
kind = "portfolio"
unit = "top30"
hypothesis = "DEV-only control, never to be submitted: H11 with the rank made orthogonal to each coin's own 26-day return across coins before averaging, to check on DEV that H11's result does not come from the price move that goes with a funding change (DEV rewarded continuation of recent moves)."

a = param(240, 192, 288)
b = param(672, 537, 807)
m = param(384, 307, 461)
size = param(0.1, 0.08, 0.12)
q = param(156, 124, 188)

shock = sma(funding8h, a) - sma(funding8h, b)
u = cs_rank(shock)
xq = cs_demean(logret(h4(close), q))
bq = cs_mean(xq * u) / cs_mean(xq * xq)
s = sma(u - bq * xq, m)
signal = size * cs_demean(-s)
