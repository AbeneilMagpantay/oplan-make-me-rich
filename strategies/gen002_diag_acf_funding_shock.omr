# DEV-ONLY DIAGNOSTIC - NOT A CANDIDATE - NEVER TO BE SUBMITTED (generations/gen002/PLAN.md, version 3, D-ACF).
# w is H9's weight row exactly as in strategies/gen002_funding_shock.omr at its defaults (an hourly-grid
# series, so lag counts hours). The signal c * w(t) * w(t - k), k = 621 hours (one G6 lag step, about 25.9
# days), makes the sandbox's avg net / avg gross equal to sum w(t) w(t-k) / sum |w(t)| |w(t-k)|, an upper
# bound of the correlation that G6's speed limit reads.
name = "gen002_diag_acf_funding_shock"
family = "other"
kind = "portfolio"
unit = "top30"
hypothesis = "DEV-only control, never to be submitted: measures on DEV how strongly H9's weights are correlated with its own weights one G6 lag step earlier, to check G6's speed limit (0.5) before any counted run. Its returns mean nothing."

a = param(42, 33, 51)
b = param(126, 100, 152)
size = param(0.1, 0.08, 0.12)
k = param(621, 496, 746)
c = param(20, 10, 30)

shock = funding_mean(a) - funding_mean(b)
w = size * cs_demean(-cs_rank(shock))
signal = c * w * lag(w, k)
