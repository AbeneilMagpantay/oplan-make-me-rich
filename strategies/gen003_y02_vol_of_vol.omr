# Generation 3, round 5, Y-02 (generations/gen003/PLAN.md, version 5, the final wide screen). Uncertainty about risk.
# e = the coin's hourly log return minus BTC's (BTC's own e is 0, so BTC drops out as 0/0). dv = the daily root mean
# square of e (the day's own volatility); vov = the standard deviation of dv over the last k days / its mean over them:
# how much the coin's own volatility itself moved around (a rise and a fall both count), unsigned. Sampled at the last
# hour of each weekly bin. Short the highest vov, long the lowest. Dollar and beta neutral (the centred rank's residual
# on the coins' centred daily beta to BTC over nb days, sum(w) = 0 and sum(w x beta) = 0 by identity); gross 1; traded
# at the Monday 00:00 open. No funding, mark or index input.
name = "gen003_y02_vol_of_vol"
family = "volatility"
kind = "portfolio"
unit = "top30"
hypothesis = "Uncertainty about risk: a coin whose own volatility has lately swung widely (high volatility of volatility) draws speculators who like uncertainty and is overpriced for a while, so it earns less over the next weeks than a coin whose risk is steady. Short the highest volatility of daily volatility over 3 weeks, long the lowest, beta neutral, weekly. Falsified if the DEV screen fails (sign never flipped), VAL PSR(0) < 0.90, 2x costs negative, no G6 timing, or next30 disagrees."

k = param(21, 16, 26)          # days over which the variability of the daily volatility is measured (3 weeks)
nb = param(42, 33, 51)         # days in the daily beta to BTC that neutralises the book (6 weeks)

e = logret(close, 1) - logret(btc(close), 1)
dv = sqrt(tf_mean(e * e, daily))
vov = std(dv, k) / sma(dv, k)
rd = logret(daily(close), 1)
rbd = logret(daily(btc(close)), 1)
bd = cs_demean(tf_last(corr(rd, rbd, nb) * std(rd, nb) / std(rbd, nb), weekly))
z = cs_demean(-cs_rank(tf_last(vov, weekly)))
w = z - cs_mean(z * bd) / cs_mean(bd * bd) * bd
signal = cs_scale(w)
