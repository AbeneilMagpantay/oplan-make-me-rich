# Generation 3, round 3, W-01 (generations/gen003/PLAN.md, version 3, the wide screen). Anchoring on the recent high.
# dd = the log distance of the coin's daily close below the highest daily high of the last n days, in units of the
# coin's own annualised daily volatility over the same n days (<= 0; 0 at a new high). Sampled at the last hour of
# each weekly bin (the Sunday daily close, visible at the bar that opens Sunday 23:00, traded at the Monday 00:00
# open), so the weights change once a week. Long the coins nearest their high, short the farthest; rank weights,
# dollar neutral, gross 1. No funding, mark or index input.
name = "gen003_w01_high_anchor"
family = "trend"
kind = "portfolio"
unit = "top30"
hypothesis = "Anchoring: traders use a coin's recent high as a reference, sell into it and are slow to bid through it, so news that lifts a coin toward its high is priced too slowly, while coins far below their high are held by loss-averse owners. Long the coins nearest their n-day high in units of their own volatility, short the farthest, weekly. Falsified if the DEV screen fails (sign never flipped), VAL PSR(0) < 0.90, 2x costs negative, no G6 timing, or next30 disagrees."

n = param(42, 33, 51)          # days in the reference window (6 weeks)

d = daily(close)
dd = log(d / rmax(daily(high), n)) / realised_vol(d, n)
signal = cs_scale(cs_demean(cs_rank(tf_last(dd, weekly))))
