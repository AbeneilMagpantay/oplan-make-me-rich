# DEV-ONLY DIAGNOSTIC - NOT A CANDIDATE - NEVER TO BE SUBMITTED (generations/gen002/PLAN.md, D-ACF).
# w is H3's weight row exactly as in strategies/gen002_small_tickets.omr at its defaults (a weekly series,
# so lag counts weeks). The signal c * w(t) * w(t - k), k = 4 weeks, makes the sandbox's avg net / avg
# gross equal to sum w(t) w(t-k) / sum |w(t)| |w(t-k)|, an upper bound of the correlation that G6's
# speed limit reads.
name = "gen002_diag_acf_small_tickets"
family = "other"
kind = "portfolio"
unit = "top30"
hypothesis = "DEV-only control, never to be submitted: measures on DEV how strongly H3's weights are correlated with its own weights about one G6 lag step (4 weeks) earlier, to check G6's speed limit (0.5) before any counted run. Its returns mean nothing."

m = param(4, 3, 6)
k = param(4, 3, 5)
c = param(20, 10, 30)

ticket = weekly(quote_volume) / weekly(trades)
abn = ticket / sma(ticket, m)
w = cs_scale(cs_demean(cs_rank(abn)))
signal = c * w * lag(w, k)
