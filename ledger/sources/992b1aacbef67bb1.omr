# Generation 0 baseline (kernel copy, hash-locked; also used as a calibration family).
name = "gen000_voltarget_trend_ls"
family = "trend"
kind = "single"
hypothesis = "Trend direction from the daily close versus its SMA (+1 above, -1 below), sized to an annualised volatility target: size = min(1, target / realised vol of the last daily log returns). Mechanism: trend persistence plus volatility clustering; cutting size in high-vol regimes should improve risk-adjusted return. Falsified if VAL PSR(0) < 0.90 or the timing permutation shows no timing skill."

ma_n = param(50, 20, 150)
vol_lookback = param(30, 10, 90)
target_vol = param(0.4, 0.2, 0.8)

d = daily(close)
direction = sign(d - sma(d, ma_n))
size = min2(1, target_vol / realised_vol(d, vol_lookback))
signal = direction * size
