# Generation 0 baseline (kernel copy, hash-locked; also used as a calibration family).
name = "gen000_funding_carry"
family = "carry"
kind = "single"
hypothesis = "Persistent funding is a carry premium: when the mean of the last lookback funding settlements (as an 8h rate) is above hi, shorting collects funding from crowded leveraged longs (-1); below lo, going long collects from crowded shorts (+1); otherwise flat. Re-decided at each settlement. Falsified if VAL PSR(0) < 0.90 or the funding stress (paid x1.5, received x0.5) turns it negative."

lookback = param(21, 6, 90)
hi = param(0.0003, 0.00015, 0.001)
lo = param(-0.0001, -0.0005, 0.0)

f = funding_mean(lookback)
signal = where(f > hi, -1, where(f < lo, 1, 0))
