# Kernel selftest program (never a trial): a deliberately meaningless signal that trades often.
name = "kernel_noise_portfolio"
family = "other"
kind = "portfolio"
hypothesis = "Selftest only: the cross-sectionally demeaned rolling rank of daily volume over its previous value carries no edge; it exists to drive the full evaluation path."

n = param(20, 10, 40)

v = daily(volume)
signal = cs_demean(2 * rank(v / lag(v, 1), n) - 1)
